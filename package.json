{
  "name": "recorder-colmap-refiner",
  "version": "0.1.0",
  "description": "Offline COLMAP pose-refinement pipeline for recorder ZIPs",
  "private": true,
  "type": "module",
  "bin": {
    "recorder-colmap-refiner": "dist/src/bin.js"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "build": "node scripts/copy-runtime.mjs && tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:package",
    "refine": "node dist/src/bin.js refine",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.26"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
